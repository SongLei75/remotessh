+        char* p = line;
+        char* val;
+
+        /* skip leading whitespace */
+        while (*p == ' ' || *p == '\t') p++;
+        /* skip comments and empty lines */
+        if (*p == '#' || *p == '\n' || *p == '\r' || *p == '\0')
+            continue;
+
+        /* strip trailing whitespace/newline */
+        {
+            int len = (int)WSTRLEN(p);
+            while (len > 0 && (p[len-1] == '\n' || p[len-1] == '\r' ||
+                               p[len-1] == ' '  || p[len-1] == '\t'))
+                p[--len] = '\0';
+        }
+
