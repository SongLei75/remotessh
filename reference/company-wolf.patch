+        socklen_t len = sizeof(on);
+        setsockopt(*sockFd, SOL_SOCKET, SO_NOSIGPIPE, &on, len);
+    }
+#endif
+}
+
+static INLINE void build_addr_unix(struct sockaddr_un* addr, const char* path)
+{
+    memset(addr, 0, sizeof(*addr));
+    addr->sun_family = AF_UNIX;
+    strncpy(addr->sun_path, path, sizeof(addr->sun_path) - 1);
+}
+#endif /* WOLFSSH_HAVE_UNIX_SOCKET */
+
+
 #if defined(WOLFSSH_TEST_SERVER) && !defined(FREESCALE_MQX)\
                                  && !defined(WOLFSSH_LWIP)
 
