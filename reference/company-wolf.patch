+                  WSTRNCASECMP(p, "IdentityFile\t", 13) == 0)) {
+            val = p + 13;
+            while (*val == ' ' || *val == '\t') val++;
+            /* Expand ~ to HOME */
+            if (val[0] == '~' && val[1] == '/') {
+                const char* home = ClientGetHomeDir();
+                if (home != NULL) {
+                    snprintf(identityFile, identityFileSz, "%s%s",
+                             home, val + 1);
+                }
+                else {
+                    snprintf(identityFile, identityFileSz, "%s", val);
+                }
+            }
+            else {
+                snprintf(identityFile, identityFileSz, "%s", val);
+            }
