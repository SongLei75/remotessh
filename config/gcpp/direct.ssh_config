# Direct-management path used to reach the GCP board simulator through IAP.
Host gcp
    HostName compute.3245549837620430106
    User songlei
    IdentityFile ~/.ssh/google_compute_engine
    CheckHostIP no
    HashKnownHosts no
    HostKeyAlias compute.3245549837620430106
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.ssh/google_compute_known_hosts
    ProxyCommand /snap/bin/gcloud compute start-iap-tunnel gcp-free-dev %p --listen-on-stdin --project=gen-lang-client-0429627202 --zone=us-west1-b --verbosity=warning
    ProxyUseFdpass no
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
