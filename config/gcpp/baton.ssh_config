# The first hop is ordinary SSH. The remote command is company wolfSSH,
# which performs the product-shaped second hop to the board simulator.
Host gcpp
    HostName 2603:c020:25:ae01:85f0:8240:1c51:a5b9
    HostKeyAlias ve1.songlei.me
    User ubuntu
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 30
    ServerAliveCountMax 3
    RequestTTY force
    RemoteCommand wolfssh -t -X -i /home/ubuntu/.ssh/client-identity.pem -l songlei -p 2222 2600:1900:4041:46c:0:2:0:0
