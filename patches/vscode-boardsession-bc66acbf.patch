+    word32           offset;
+    /* Current offset into ASN.1 data. */
+    word32           curr;
+    /* Next part of ASN.1 item expected. */
+    unsigned char    part;
+
+    /* File pointer to print to. */
+    XFILE            file;
+
+    /* Callback to get a name for an hex OID. */
+    Asn1OidToNameCb  nameCb;
+} Asn1;
