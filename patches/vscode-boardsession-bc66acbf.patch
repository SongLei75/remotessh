+    WOLFSSL_BIGNUM* d;              /* Private exponent. */
+    WOLFSSL_BIGNUM* p;              /* First prime. */
+    WOLFSSL_BIGNUM* q;              /* Second prime. */
+    WOLFSSL_BIGNUM* dmp1;           /* dP = d mod (p - 1) */
+    WOLFSSL_BIGNUM* dmq1;           /* dQ = d mod (q - 1) */
+    WOLFSSL_BIGNUM* iqmp;           /* u = (1 / q) mod p */
