+            if (mqxdir == NULL) {
+                WLOG(WS_LOG_SFTP, "Unable to allocate MQXDIR in wOpenDir");
+                return -1;
+            }
+            WMEMSET(mqxdir, 0, sizeof(MQXDIR));
+            mqxdir->heap = heap;
