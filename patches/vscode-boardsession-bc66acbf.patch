+        /* We need a do-nothing function with a variable number of parameters */
+        /* see logging.c
+         *   static inline void WOLFSSL_MSG_EX(const char* fmt, ...); */
+    #else
+        #define WOLFSSL_MSG_EX(...)   WC_DO_NOTHING
+    #endif
+#endif
+    WOLFSSL_API void WOLFSSL_MSG(const char* msg);
