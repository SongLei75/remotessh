+            if (mqxdir->pathname[pathSz-1] != WS_DELIM) {
+                if (pathSz + 2 > sizeof(mqxdir->pathname)) {
+                    WFREE(mqxdir, mqxdir->heap, DYNTYPE_SFTP);
+                    return -1;
+                }
+                mqxdir->pathname[pathSz] = WS_DELIM;
+                mqxdir->pathname[pathSz + 1] = '\0';
