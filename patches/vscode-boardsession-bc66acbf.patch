+
+#ifndef WOLF_CRYPT_DILITHIUM_H
+#define WOLF_CRYPT_DILITHIUM_H
+
+#include <wolfssl/wolfcrypt/types.h>
+
+#ifdef WOLF_CRYPTO_CB
