+#ifdef WOLFSSL_NUCLEUS
+    #define WFD_SET_TYPE FD_SET
+    #define WFD_SET NU_FD_Set
+    #define WFD_ZERO NU_FD_Init
+    #define WFD_ISSET NU_FD_Check
+#else
+    #define WFD_SET_TYPE fd_set
+    #define WFD_SET FD_SET
+    #define WFD_ZERO FD_ZERO
+    #define WFD_ISSET FD_ISSET
