index 0000000000000000000000000000000000000000..8daba6d07847d77e8bb2ce6badc32b09554ecd44
--- /dev/null
+++ b/extensions/boardsession/board-session/build/wolfssl/include/wolfssl/wolfcrypt/chacha20_poly1305.h
@@ -0,0 +1,157 @@
+/* chacha20_poly1305.h
+ *
+ * Copyright (C) 2006-2026 wolfSSL Inc.
+ *
+ * This file is part of wolfSSL.
+ *
+ * wolfSSL is free software; you can redistribute it and/or modify
