+WOLFSSL_LOCAL void Entropy_Final(void);
+
+#ifdef __cplusplus
+    } /* extern "C" */
+#endif
+
+#endif /* HAVE_ENTROPY_MEMUSE */
+#endif /* WOLFENTROPY_H */
