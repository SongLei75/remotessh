+    AES_MAX_LABEL_LEN   = 32,
+#endif
+
+    WOLF_ENUM_DUMMY_LAST_ELEMENT(AES)
+};
+
+#ifdef WC_AES_BITSLICED
+    #ifdef WC_AES_BS_WORD_SIZE
+        #define BS_WORD_SIZE        WC_AES_BS_WORD_SIZE
+    #elif defined(NO_64BIT)
