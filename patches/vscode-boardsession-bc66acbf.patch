diff --git a/extensions/boardsession/board-session/package.json b/extensions/boardsession/board-session/package.json
new file mode 100644
index 0000000000000000000000000000000000000000..4c3c519ebb410bdd2f89d30e194071371f9f4396
--- /dev/null
+++ b/extensions/boardsession/board-session/package.json
@@ -0,0 +1,45 @@
+{
+  "name": "@carizon/board-session",
+  "version": "0.1.0",
+  "description": "Persistent local wolfSSH X.509 sessions through zero or more SSH jumps",
+  "license": "UNLICENSED",
+  "type": "module",
+  "main": "./dist/index.js",
+  "types": "./dist/index.d.ts",
+  "exports": {
+    ".": {
+      "types": "./dist/index.d.ts",
+      "import": "./dist/index.js"
+    }
+  },
+  "files": [
+    "dist",
+    "prebuilds",
+    "README.md",
+    "THIRD_PARTY_NOTICES.md",
+    "debug/client-identity.pem"
+  ],
+  "engines": {
+    "node": ">=22"
+  },
+  "os": [
+    "linux"
+  ],
+  "scripts": {
+    "build": "npm run build:native && npm run build:ts",
+    "build:native": "node scripts/build-native.mjs",
+    "build:ts": "tsc -p tsconfig.json",
+    "prepack": "npm run build:ts && node scripts/check-package.mjs",
+    "check": "tsc -p tsconfig.json --noEmit",
+    "test:functional": "node scripts/functional.mjs",
+    "build:deps": "node scripts/build-wolfssh.mjs"
+  },
+  "dependencies": {
+    "ssh2": "^1.17.0"
+  },
+  "devDependencies": {
+    "@types/node": "^24.0.0",
+    "@types/ssh2": "^1.15.5",
+    "typescript": "^5.9.3"
+  }
+}
