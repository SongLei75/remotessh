index 0000000000000000000000000000000000000000..dad4d31cb8a758a7129f87f96bf10c0bc7041c4b
--- /dev/null
+++ b/extensions/boardsession/src/extension.ts
@@ -0,0 +1,17 @@
+import * as vscode from 'vscode';
+import { BoardSession } from '../board-session/dist/index.js';
+import { BoardConnection } from './boardConnection.js';
+import { registerBoardTerminalTools } from './boardTerminalTools.js';
+
+/** Export the npm API, and attach the optional board terminal to Copilot Chat. */
+export async function activate(context: vscode.ExtensionContext) {
+	const connection = new BoardConnection();
+	await connection.initialize();
+	context.subscriptions.push(
+		vscode.commands.registerCommand('boardsession.connect', () => connection.connect(context)),
+		vscode.commands.registerCommand('boardsession.disconnect', () => connection.disconnect()),
+		{ dispose: () => { void connection.disconnect(); } },
+	);
+	registerBoardTerminalTools(context, connection);
+	return { BoardSession };
+}
