+            /* copy dir to pathname */
+            pathSz = WSTRLEN(dir);
+
+            if (pathSz > sizeof(mqxdir->pathname)) {
+                WLOG(WS_LOG_SFTP, "dir name too large for buffer");
+                WFREE(mqxdir, mqxdir->heap, DYNTYPE_SFTP);
+                return -1;
