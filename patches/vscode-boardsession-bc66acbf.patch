+#define wolfSSL_RefCur(ref) WOLFSSL_ATOMIC_LOAD((ref).count)
+#else
+typedef struct wolfSSL_RefWithMutex wolfSSL_Ref;
+#define wolfSSL_RefCur(ref) wolfSSL_RefWithMutexCur(ref)
+#endif
