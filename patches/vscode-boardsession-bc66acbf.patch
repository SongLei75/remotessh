+    #define SHA224 wolfSSL_SHA224
+#endif
+#endif /* !OPENSSL_COEXIST && (OPENSSL_EXTRA || OPENSSL_EXTRA_X509_SMALL) */
+#endif /* WOLFSSL_SHA224 */
