+        int b = 0x01;
+        SSL_SESSION_set_cipher(lsess, cipher);
+        for (i = 0; i < 32; i++, b += 0x22) {
+            if (b >= 0x100)
+                b = 0x01;
+            local_psk[i] = (unsigned char) b;
+        }
+
+        *id = local_psk;
+        *idlen = 32;
+        *sess = lsess;
+
+        return 1;
+    }
+    else {
+        *id = NULL;
+        *idlen = 0;
+        *sess = NULL;
+        SSL_SESSION_free(lsess);
+        return 0;
+    }
+#else
+    (void)ssl;
+    (void)md;
+    (void)id;
+    (void)idlen;
+    (void)sess;
+
+    return 0;
+#endif
+}
+#endif /* OPENSSL_EXTRA */
