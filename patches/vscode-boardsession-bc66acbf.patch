diff --git a/extensions/boardsession/src/boardConnection.ts b/extensions/boardsession/src/boardConnection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39facb7bcfd1bcad2533c477ba4ca1cbc2182862
--- /dev/null
+++ b/extensions/boardsession/src/boardConnection.ts
@@ -0,0 +1,127 @@
+import * as vscode from 'vscode';
+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { BoardSession, type OpenOptions } from '../board-session/dist/index.js';
+
+const modeKey = 'boardsession.connected';
+const defaultIdentity = join('board-session', 'debug', 'client-identity.pem');
+
+/** Owns the board connection. Copilot tools and the chat button share this one session. */
+export class BoardConnection {
+	private session: BoardSession | undefined;
+	private switching = false;
+
+	get active(): boolean {
+		return this.session !== undefined && !this.session.isClosed;
+	}
+
+	get current(): BoardSession {
+		if (!this.active) {
+			throw new Error('Board terminal is disconnected. Use the connection button in Copilot Chat.');
+		}
+		return this.session!;
+	}
+
+	async initialize(): Promise<void> {
+		await vscode.commands.executeCommand('setContext', modeKey, false);
+	}
+
+	async connect(context: vscode.ExtensionContext): Promise<void> {
+		if (this.switching || this.active) {
+			return;
+		}
+		this.switching = true;
+		try {
+			const boardUser = await vscode.window.showInputBox({
+				title: 'Board SSH · User', prompt: 'Board username (empty = root)', value: 'root',
+			});
+			if (boardUser === undefined) { return; }
+			const boardHost = await vscode.window.showInputBox({
+				title: 'Board SSH · Host', prompt: 'Board IP / hostname (empty = 192.168.2.62)', value: '192.168.2.62',
+			});
+			if (boardHost === undefined) { return; }
+			const boardPort = await this.askPort('Board SSH · Port');
+			if (boardPort === undefined) { return; }
+			const keyPath = await vscode.window.showInputBox({
+				title: 'Board SSH · X.509 identity',
+				prompt: 'Composite PEM file path (empty = local package debug identity)',
+				value: join(context.extensionUri.fsPath, defaultIdentity),
+			});
+			if (keyPath === undefined) { return; }
+
+			const jumps: NonNullable<OpenOptions['jumps']> = [];
+			for (let index = 1; ; index++) {
+				const username = await vscode.window.showInputBox({
+					title: `Jump server ${index} · User`,
+					prompt: 'Username is required to add a jump; empty = no more jump servers',
+					value: '',
+				});
+				if (username === undefined) { return; }
+				if (!username.trim()) { break; }
+				const host = await vscode.window.showInputBox({
+					title: `Jump server ${index} · Host`,
+					prompt: 'Jump server IP / hostname (required)',
+					validateInput: value => value.trim() ? undefined : 'Jump host must not be empty',
+				});
+				if (host === undefined) { return; }
+				const port = await this.askPort(`Jump server ${index} · Port`);
+				if (port === undefined) { return; }
+				const password = await vscode.window.showInputBox({
+					title: `Jump server ${index} · Password`,
+					prompt: 'Jump SSH password (empty = 123456)',
+					password: true, value: '123456',
+				});
+				if (password === undefined) { return; }
+				jumps.push({
+					username: username.trim(), host: host.trim(), port,
+					password: password || '123456',
+				});
+			}
+
+			const identityPath = keyPath.trim() || join(context.extensionUri.fsPath, defaultIdentity);
+			const identity = await readFile(identityPath);
+			try {
+				await BoardSession.setIdentity(identity);
+			} finally {
+				identity.fill(0);
+			}
+			const candidate = await BoardSession.open({
+				board: {
+					username: boardUser.trim() || 'root',
+					host: boardHost.trim() || '192.168.2.62',
+					port: boardPort,
+				},
+				jumps,
+			});
+			this.session = candidate;
+			await vscode.commands.executeCommand('setContext', modeKey, true);
+			vscode.window.showInformationMessage('Board terminal connected. Copilot Chat now uses board_terminal tools.');
+		} catch (error) {
+			void vscode.window.showErrorMessage(`Board terminal connection failed: ${String(error)}`);
+		} finally {
+			this.switching = false;
+		}
+	}
+
+	async disconnect(): Promise<void> {
+		if (this.switching) {
+			return;
+		}
+		const session = this.session;
+		this.session = undefined;
+		await vscode.commands.executeCommand('setContext', modeKey, false);
+		await session?.close();
+	}
+
+	private async askPort(title: string): Promise<number | undefined> {
+		const value = await vscode.window.showInputBox({
+			title, prompt: 'SSH port (empty = 22)', value: '22',
+			validateInput: text => {
+				const port = Number(text.trim() || 22);
+				return Number.isInteger(port) && port > 0 && port <= 65535
+					? undefined : 'Enter a TCP port between 1 and 65535';
+			},
+		});
+		return value === undefined ? undefined : Number(value.trim() || 22);
+	}
+}
diff --git a/extensions/boardsession/src/boardTerminalTools.ts b/extensions/boardsession/src/boardTerminalTools.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c9ab1c2561a1ca12b45772336b71534fab7942bb
--- /dev/null
+++ b/extensions/boardsession/src/boardTerminalTools.ts
@@ -0,0 +1,73 @@
+import * as vscode from 'vscode';
+import { BoardConnection } from './boardConnection.js';
+
+interface RunInput {
+	command: string;
+	timeoutMs?: number;
+}
+
+interface SendInput {
+	command: string;
+	appendNewline?: boolean;
+}
+
+const terminalId = 'board';
+
+/** Registers the remote equivalents of Copilot's four executable terminal tools. */
+export function registerBoardTerminalTools(
+	context: vscode.ExtensionContext,
+	connection: BoardConnection,
+): void {
+	const result = (value: object): vscode.LanguageModelToolResult =>
+		new vscode.LanguageModelToolResult([new vscode.LanguageModelTextPart(JSON.stringify(value))]);
+
+	context.subscriptions.push(vscode.lm.registerTool<RunInput>('board_terminal_run', {
+		prepareInvocation: ({ input }) => ({
+			invocationMessage: 'Running a command on the connected board',
+			confirmationMessages: {
+				title: 'Run command on remote board?',
+				message: input.command,
+			},
+		}),
+		async invoke({ input }) {
+			const session = connection.current;
+			const output = await session.exec(input.command, input.timeoutMs ?? 30_000);
+			return result({ id: terminalId, ...output });
+		},
+	}));
+
+	context.subscriptions.push(vscode.lm.registerTool<SendInput>('board_terminal_send', {
+		prepareInvocation: ({ input }) => ({
+			invocationMessage: 'Sending input to the board terminal',
+			confirmationMessages: {
+				title: 'Send input to remote board?',
+				message: input.command || '(Enter)',
+			},
+		}),
+		async invoke({ input }) {
+			const session = connection.current;
+			const output = await session.send(input.command, input.appendNewline ?? true);
+			return result({ id: terminalId, ...output });
+		},
+	}));
+
+	context.subscriptions.push(vscode.lm.registerTool<Record<string, never>>('board_terminal_output', {
+		async invoke() {
+			return result({ id: terminalId, ...connection.current.read() });
+		},
+	}));
+
+	context.subscriptions.push(vscode.lm.registerTool<Record<string, never>>('board_terminal_kill', {
+		prepareInvocation: () => ({
